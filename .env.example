# Generación de contenido pedagógico (guías, DUA, exámenes, Kahoot).
# Consigue una API key en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Conexión a Postgres (catálogo, calendario, guías).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cliente server-side de Supabase Storage (binarios de guías/exámenes generados).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OAuth de Google para el login (Auth.js) — crea credenciales en
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firma de sesión de Auth.js — genera uno con: npx auth secret
AUTH_SECRET=

# Carpeta de fuentes DejaVu para la imagen motivacional y la ruta visual
# (Python/Pillow). Déjalo vacío en local si tienes las fuentes en la ruta
# por defecto de tu sistema; el Dockerfile ya instala fonts-dejavu-core en
# la ruta de abajo.
FONT_DIR=/usr/share/fonts/truetype/dejavu

# Sincronización de mallas desde Google Drive (botón "Sincronizar desde
# Drive" en /admin/mallas) — cuenta de servicio de Google Cloud, sin login
# de docente de por medio. GOOGLE_SERVICE_ACCOUNT_KEY es el contenido
# COMPLETO del JSON descargado al crear la cuenta de servicio (en una sola
# línea). Comparte la carpeta "01_MALLAS_CONTENIDO/" de Drive como lectora
# con el email client_email de ese JSON, y pega acá el id de esa carpeta
# (de la URL: drive.google.com/drive/folders/<ESTE_ID>).
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_MALLAS_FOLDER_ID=

# Tope de generaciones con IA por docente cada 24h, en /api/generar-guia y
# /api/generar-examen (protección de costo — ver src/lib/rateLimit.ts).
# Vacío = usa el valor por defecto (30).
LIMITE_GENERACIONES_DIA=
